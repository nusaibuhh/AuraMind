# AuraMind central MySQL database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=auramind
MYSQL_PASSWORD=replace_with_your_password
MYSQL_DATABASE=auramind

# SSLCOMMERZ hosted checkout. Keep credentials on the backend only.
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
SSLCOMMERZ_SANDBOX=true

# Public HTTPS base URL used by SSLCOMMERZ success/fail/cancel/IPN callbacks.
# For local mobile testing, use a trusted tunnel URL instead of 127.0.0.1.
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Protected administrator account (override the local demo defaults before deployment)
ADMIN_EMAIL=admin@auramind.local
ADMIN_PASSWORD=Admin@1234
